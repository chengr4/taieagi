{
  "manifest_version": 3,
  "name": "Taieagi 臺灣本土語言快彈詞盤",
  "version": "0.2.1",
  "author": "R4 Cheng",
  "description": "社群留言臺灣本土語言正字快彈詞盤（現已支援臺灣閩南語臺羅拼音輸入）。",
  "action": {
    "default_title": "Taieagi 臺灣本土語言快彈詞盤",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "commands": {
    "toggle-palette": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "Option+T"
      },
      "description": "喚起 / 關閉臺灣本土語言快彈詞盤"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "palette.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
