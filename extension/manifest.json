{
  "manifest_version": 3,
  "name": "Taieagi 台灣閩南語快彈輸入法",
  "version": "0.1.0",
  "author": "R4 Cheng",
  "description": "社群留言台灣閩南語正字快彈輸入器 (臺羅拼音輸入)。",
  "action": {
    "default_title": "Taieagi 台灣閩南語快彈輸入法"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "commands": {
    "toggle-palette": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "Option+T"
      },
      "description": "喚起 / 關閉台灣閩南語快彈輸入器"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["palette.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pkg/taieagi_bg.wasm"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
